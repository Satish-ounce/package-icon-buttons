{
  "name": "@proounce/icon-buttons",
  "version": "1.0.0",
  "description": "React + MUI component library",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "clean": "rimraf dist",
    "build:webpack": "webpack --mode=production",
    "build:css": "postcss src/tailwind-base.css -o src/tailwind-gen.css",
    "build:types": "tsc",
    "build": "npm run clean && concurrently \"npm:build:webpack\" \"npm:build:css\" \"npm:build:types\"",
    "lint": "eslint src --ext js,ts,jsx,tsx",
    "format": "prettier --write .",
    "check-format": "prettier --check .",
    "prepare": "husky install",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "react",
    "mui",
    "components"
  ],
  "author": "proounce",
  "license": "MIT",
  "peerDependencies": {
    "@mui/icons-material": "^5.15.18",
    "@mui/material": "5.15.18",
    "@types/react": "^18.2.21",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.23.3",
    "@babel/eslint-parser": "^7.28.4",
    "@babel/plugin-transform-runtime": "^7.23.3",
    "@babel/preset-env": "^7.23.3",
    "@babel/preset-react": "^7.23.3",
    "@babel/preset-typescript": "^7.23.3",
    "@types/node": "^16.18.126",
    "autoprefixer": "^9.8.6",
    "babel-loader": "^8.3.0",
    "concurrently": "^6.2.1",
    "cross-env": "^10.1.0",
    "css-loader": "^7.1.2",
    "eslint": "^7.32.0",
    "eslint-config-prettier": "^8.3.0",
    "eslint-config-ts-react-important-stuff": "^3.0.0",
    "eslint-plugin-prettier": "^3.4.1",
    "husky": "^7.0.2",
    "mini-css-extract-plugin": "^2.9.4",
    "postcss-cli": "^11.0.0",
    "postcss-loader": "^8.2.0",
    "prettier": "^2.3.2",
    "pretty-quick": "^3.1.1",
    "rimraf": "^6.0.1",
    "style-loader": "^4.0.0",
    "tailwindcss": "^3.4.3",
    "ts-loader": "^9.5.4",
    "typescript": "^4.3.5",
    "webpack": "^5.89.0",
    "webpack-cli": "^4.10.0",
    "webpack-dev-server": "^4.0.0"
  },
  "dependencies": {
    "@emotion/react": "^11.11.4",
    "@emotion/styled": "^11.11.5"
  }
}
